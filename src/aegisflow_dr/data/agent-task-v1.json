{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aegisflow:agents:task:1",
  "title": "AegisFlow agent task v1",
  "description": "One bounded unit of work handed to one catalog role. Inputs are evidence references (id plus SHA-256), never raw records.",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "run_id", "tenant_id", "case_id", "agent_id", "goal", "input_refs", "allowed_tools", "budget",
               "policy_version"],
  "properties": {
    "task_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "tenant_id": {"type": "string", "pattern": "^[a-z0-9-]{1,64}(?![\\s\\S])", "maxLength": 64},
    "case_id": {"$ref": "#/$defs/id"},
    "agent_id": {"type": "string", "pattern": "^A(?:0[1-9]|[12][0-9]|3[0-6])(?![\\s\\S])", "maxLength": 3},
    "goal": {"type": "string", "minLength": 1, "maxLength": 300},
    "input_refs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence_ref"}},
    "allowed_tools": {
      "type": "array", "maxItems": 16, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])", "maxLength": 64}
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_tool_calls", "max_llm_calls", "max_tokens", "deadline_ms"],
      "properties": {
        "max_tool_calls": {"type": "integer", "minimum": 0, "maximum": 64},
        "max_llm_calls": {"type": "integer", "minimum": 0, "maximum": 12},
        "max_tokens": {"type": "integer", "minimum": 0, "maximum": 40000},
        "deadline_ms": {"type": "integer", "minimum": 1, "maximum": 90000}
      }
    },
    "policy_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,31}(?![\\s\\S])", "maxLength": 32}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,63}(?![\\s\\S])", "maxLength": 64},
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])", "minLength": 64, "maxLength": 64}
      }
    }
  }
}
