{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aegisflow:agents:run:1",
  "title": "AegisFlow agent run v1",
  "description": "The record of one agent run over the 36 roles: selection with reasons, waves, every task and validated result, the ordered event log, Judge verdicts per claim, proposals awaiting human approval, usage, evaluation, transports with certificate fingerprints, budgets and a SHA-256 over the canonical record.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "run_id", "tenant_id", "case_id", "started_at", "finished_at", "duration_ms", "status", "intake",
               "plan", "selection", "waves", "agents", "events", "judge", "proposals", "approvals", "usage", "evaluation",
               "transports", "budget", "recovery", "evidence", "event_log", "trace_sha256"],
  "properties": {
    "version": {"const": "1"},
    "run_id": {"$ref": "#/$defs/id"},
    "tenant_id": {"type": "string", "pattern": "^[a-z0-9-]{1,64}(?![\\s\\S])", "maxLength": 64},
    "case_id": {"$ref": "#/$defs/id"},
    "started_at": {"$ref": "#/$defs/timestamp"},
    "finished_at": {"$ref": "#/$defs/timestamp"},
    "duration_ms": {"$ref": "#/$defs/count"},
    "status": {"enum": ["completed", "completed_with_gaps", "failed_agents", "budget_exceeded", "input_rejected"]},
    "intake": {"type": ["object", "null"]},
    "plan": {"type": ["object", "null"]},
    "selection": {
      "type": "array", "minItems": 36, "maxItems": 36,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["agent_id", "selected", "reason", "error_code"],
        "properties": {
          "agent_id": {"$ref": "#/$defs/agent"},
          "selected": {"type": "boolean"},
          "reason": {"$ref": "#/$defs/key"},
          "error_code": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/code"}]}
        }
      }
    },
    "waves": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["wave", "stage", "agents"],
        "properties": {
          "wave": {"type": "integer", "minimum": 1},
          "stage": {"$ref": "#/$defs/key"},
          "agents": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/agent"}}
        }
      }
    },
    "agents": {
      "type": "array", "minItems": 36, "maxItems": 36,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["agent_id", "name", "layer", "kind", "selected", "wave", "attempts", "task", "result"],
        "properties": {
          "agent_id": {"$ref": "#/$defs/agent"},
          "name": {"type": "string", "minLength": 1, "maxLength": 128},
          "layer": {"enum": ["orchestration", "specialists", "reasoning", "remediation", "governance"]},
          "kind": {"enum": ["control", "rule", "llm", "hybrid"]},
          "selected": {"type": "boolean"},
          "wave": {"type": ["integer", "null"], "minimum": 1},
          "attempts": {"type": "integer", "minimum": 0, "maximum": 64},
          "task": {"anyOf": [{"type": "null"}, {"$ref": "urn:aegisflow:agents:task:1"}]},
          "result": {"$ref": "urn:aegisflow:agents:result:1"}
        }
      }
    },
    "events": {
      "type": "array", "maxItems": 4096,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["seq", "t_ms", "agent_id", "type", "data"],
        "properties": {
          "seq": {"type": "integer", "minimum": 1},
          "t_ms": {"$ref": "#/$defs/count"},
          "agent_id": {"$ref": "#/$defs/agent"},
          "type": {"enum": ["run_started", "agent_selected", "agent_skipped", "agent_started", "tool_call", "llm_call",
                            "retrieval", "cache", "agent_finished", "judge_verdict", "approval_requested",
                            "run_finished"]},
          "data": {"type": "object"}
        }
      }
    },
    "judge": {
      "type": "object", "additionalProperties": false,
      "required": ["transport", "verdicts", "accepted", "advisory", "rejected", "accepted_findings"],
      "properties": {
        "transport": {"$ref": "#/$defs/transport_choice"},
        "verdicts": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["agent", "claim", "verdict", "reason", "pass"],
            "properties": {
              "agent": {"anyOf": [{"$ref": "#/$defs/agent"}, {"const": "invalid"}]},
              "claim": {"type": ["integer", "null"], "minimum": 0},
              "text_key": {"$ref": "#/$defs/key"},
              "verdict": {"enum": ["accepted", "advisory", "rejected"]},
              "reason": {"$ref": "#/$defs/key"},
              "pass": {"enum": ["gate", "closing"]}
            }
          }
        },
        "accepted": {"$ref": "#/$defs/count"},
        "advisory": {"$ref": "#/$defs/count"},
        "rejected": {"$ref": "#/$defs/count"},
        "accepted_findings": {"type": "array"}
      }
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object", "required": ["agent", "text_key", "params", "executed"],
        "properties": {"agent": {"$ref": "#/$defs/agent"}, "executed": {"const": false}}
      }
    },
    "approvals": {
      "type": "array", "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["agent", "decision", "executed", "items"],
        "properties": {"agent": {"const": "A33"}, "decision": {"const": "pending"}, "executed": {"const": false},
                       "items": {"type": "array"}}
      }
    },
    "usage": {
      "type": "object", "additionalProperties": false, "required": ["agents", "intake", "totals", "external_spend_usd"],
      "properties": {
        "agents": {"type": "object", "minProperties": 36, "maxProperties": 36},
        "intake": {"type": "object"},
        "totals": {"type": "object"},
        "external_spend_usd": {"const": 0}
      }
    },
    "evaluation": {"type": ["object", "null"]},
    "transports": {
      "type": "object", "additionalProperties": false, "required": ["requested", "tools", "judge", "agents"],
      "properties": {
        "requested": {"enum": ["auto", "in_process", "mcp", "a2a"]},
        "tools": {"$ref": "#/$defs/transport_choice"},
        "judge": {"$ref": "#/$defs/transport_choice"},
        "agents": {"type": "object", "minProperties": 36, "maxProperties": 36,
                   "additionalProperties": {"enum": ["in_process", "mcp_local", "a2a_mtls"]}}
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false, "required": ["limits", "used", "exceeded"],
      "properties": {
        "limits": {"$ref": "#/$defs/budget_values"},
        "used": {"$ref": "#/$defs/budget_values"},
        "exceeded": {"type": "array", "uniqueItems": true,
                     "items": {"enum": ["specialists", "llm_calls", "tokens", "elapsed_ms"]}}
      }
    },
    "recovery": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["agent", "error_code", "decision", "retried"],
        "properties": {
          "agent": {"$ref": "#/$defs/agent"},
          "error_code": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/code"}]},
          "decision": {"enum": ["retry_once_same_input", "safe_stop"]},
          "retried": {"type": "boolean"}
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "sha256", "kind"],
        "properties": {"id": {"$ref": "#/$defs/id"}, "sha256": {"$ref": "#/$defs/hex64"}, "kind": {"$ref": "#/$defs/key"}}
      }
    },
    "event_log": {
      "type": "object", "additionalProperties": false, "required": ["dropped", "callback_errors"],
      "properties": {"dropped": {"$ref": "#/$defs/count"}, "callback_errors": {"$ref": "#/$defs/count"}}
    },
    "trace_sha256": {"$ref": "#/$defs/hex64"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,63}(?![\\s\\S])", "maxLength": 64},
    "agent": {"type": "string", "pattern": "^A(?:0[1-9]|[12][0-9]|3[0-6])(?![\\s\\S])", "maxLength": 3},
    "key": {"type": "string", "pattern": "^[a-z][a-z0-9_.]{0,63}(?![\\s\\S])", "maxLength": 64},
    "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}(?![\\s\\S])", "maxLength": 64},
    "hex64": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])", "minLength": 64, "maxLength": 64},
    "count": {"type": "integer", "minimum": 0, "maximum": 1000000000},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z(?![\\s\\S])"},
    "budget_values": {
      "type": "object", "additionalProperties": false, "required": ["specialists", "llm_calls", "tokens", "elapsed_ms"],
      "properties": {"specialists": {"$ref": "#/$defs/count"}, "llm_calls": {"$ref": "#/$defs/count"},
                     "tokens": {"type": "integer"}, "elapsed_ms": {"$ref": "#/$defs/count"}}
    },
    "transport_choice": {
      "type": "object", "required": ["mode", "reason"],
      "properties": {
        "mode": {"enum": ["in_process", "mcp_local", "a2a_mtls"]},
        "reason": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/key"}]},
        "ca_sha256": {"$ref": "#/$defs/hex64"},
        "server_sha256": {"$ref": "#/$defs/hex64"},
        "client_sha256": {"$ref": "#/$defs/hex64"},
        "tls": {"const": "TLSv1.3"},
        "address": {"const": "127.0.0.1"}
      },
      "additionalProperties": false
    }
  }
}
