{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aegisflow:agents:result:1",
  "title": "AegisFlow agent result v1",
  "description": "The outcome of one agent task. Claims are message keys with bounded parameters bound to evidence references; model text may appear only in advisory_text, which is never evidence. Proposed actions are never executed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "claims", "evidence_refs", "uncertainty", "proposed_actions", "usage", "transport", "llm",
               "retrieval", "error_code", "advisory_text"],
  "properties": {
    "status": {"enum": ["COMPLETED", "NEEDS_EVIDENCE", "POLICY_DENIED", "SKIPPED", "FAILED"]},
    "claims": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/claim"}},
    "evidence_refs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence_ref"}},
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "reason"],
      "properties": {
        "level": {"enum": ["low", "medium", "high"]},
        "reason": {"$ref": "#/$defs/key"}
      }
    },
    "proposed_actions": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/proposed_action"}},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_calls", "llm_calls", "tokens_in", "tokens_out", "latency_ms"],
      "properties": {
        "tool_calls": {"$ref": "#/$defs/count"},
        "llm_calls": {"$ref": "#/$defs/count"},
        "tokens_in": {"$ref": "#/$defs/count"},
        "tokens_out": {"$ref": "#/$defs/count"},
        "latency_ms": {"$ref": "#/$defs/count"}
      }
    },
    "transport": {"enum": ["in_process", "mcp_local", "a2a_mtls"]},
    "llm": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "model", "prompt_sha256", "temperature", "seed"],
          "properties": {
            "provider": {"$ref": "#/$defs/key"},
            "model": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}(?![\\s\\S])", "maxLength": 64},
            "prompt_sha256": {"$ref": "#/$defs/hex64"},
            "temperature": {"const": 0},
            "seed": {"const": 7}
          }
        }
      ]
    },
    "retrieval": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["citations", "cache"],
          "properties": {
            "citations": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/citation"}},
            "cache": {"enum": ["hit", "miss", "none"]}
          }
        }
      ]
    },
    "error_code": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}(?![\\s\\S])", "maxLength": 64}
      ]
    },
    "advisory_text": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 600}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "COMPLETED"}}},
      "then": {"properties": {"error_code": {"type": "null"}}},
      "else": {"properties": {"error_code": {"type": "string"}, "claims": {"maxItems": 0},
                              "proposed_actions": {"maxItems": 0}}}
    }
  ],
  "$defs": {
    "hex64": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])", "minLength": 64, "maxLength": 64},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,63}(?![\\s\\S])", "maxLength": 64},
    "key": {"type": "string", "pattern": "^[a-z][a-z0-9_.]{0,63}(?![\\s\\S])", "maxLength": 64},
    "count": {"type": "integer", "minimum": 0, "maximum": 1000000000},
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "sha256": {"$ref": "#/$defs/hex64"}}
    },
    "scalar": {
      "anyOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "number"},
        {"type": "string", "maxLength": 128}
      ]
    },
    "params": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,31}(?![\\s\\S])", "maxLength": 32},
      "additionalProperties": {
        "anyOf": [
          {"$ref": "#/$defs/scalar"},
          {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/scalar"}}
        ]
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text_key", "params", "evidence_refs"],
      "properties": {
        "text_key": {"$ref": "#/$defs/key"},
        "params": {"$ref": "#/$defs/params"},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
                          "items": {"$ref": "#/$defs/evidence_ref"}}
      }
    },
    "proposed_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text_key", "params", "executed"],
      "properties": {
        "text_key": {"$ref": "#/$defs/key"},
        "params": {"$ref": "#/$defs/params"},
        "executed": {"const": false}
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "revision", "citation"],
      "properties": {
        "source": {"type": "string", "minLength": 1, "maxLength": 128},
        "revision": {"type": "string", "minLength": 1, "maxLength": 64},
        "citation": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    }
  }
}
