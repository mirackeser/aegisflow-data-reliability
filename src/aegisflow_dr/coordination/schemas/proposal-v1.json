{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aegisflow:coordination:proposal:1",
  "title": "AegisFlow proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "run_id",
    "incident_id",
    "assessment",
    "evidence_sha256"
  ],
  "properties": {
    "version": {
      "const": "1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$",
      "minLength": 36,
      "maxLength": 36
    },
    "incident_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$",
      "minLength": 36,
      "maxLength": 36
    },
    "assessment": {
      "enum": [
        "NO_FAILURE_OBSERVED",
        "SOURCE_QUALITY_FAILURE",
        "TRANSFORMATION_RECONCILIATION_FAILURE"
      ]
    },
    "evidence_sha256": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "minLength": 64,
        "maxLength": 64
      },
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true
    }
  }
}
