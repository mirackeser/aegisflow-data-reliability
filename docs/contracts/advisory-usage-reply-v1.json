{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "attestation_hex": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2})+$",
      "maxLength": 8192
    },
    "signature_hex": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2})+$",
      "maxLength": 4096
    }
  },
  "required": [
