{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1"
    },
    "development_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,64}$"
          },
          "family": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,64}$"
          },
          "group_id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,64}$"
          },
          "content_signature_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          }
        },
        "required": [
          "case_id",
          "family",
          "group_id",
          "content_signature_sha256"
        ]
      }
    }
  },
  "required": [
    "version",
    "development_sha256",
    "candidate_sha256",
    "cases"
  ]
}
