{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1"
    },
    "operation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._/-]{0,63}$",
            "maxLength": 64,
            "not": {
              "pattern": "\\s"
            }
          },
          "request_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "quote_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          }
        },
        "required": [
          "model_id",
          "request_sha256",
          "input_sha256",
          "quote_sha256"
        ]
      }
    }
  },
  "required": [
    "version",
    "operation_sha256",
    "steps"
  ]
}
