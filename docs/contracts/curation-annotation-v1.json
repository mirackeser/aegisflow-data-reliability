{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1"
    },
    "reviewer_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,64}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,64}$"
          },
          "label": {
            "enum": [
              "NO_FAILURE_OBSERVED",
              "SOURCE_QUALITY_FAILURE",
              "TRANSFORMATION_RECONCILIATION_FAILURE"
            ]
          }
        },
        "required": [
          "case_id",
          "label"
        ]
      }
    }
  },
  "required": [
    "version",
    "reviewer_id",
    "manifest_sha256",
    "labels"
  ]
}
