{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "encrypted-curation-v1"
    },
    "key_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,64}$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "minLength": 32,
      "maxLength": 32
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "development": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "candidate": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "annotation_a": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "annotation_b": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "envelope_a": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "envelope_b": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "trust_policy": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "signed_header": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "development",
        "candidate",
        "annotation_a",
        "annotation_b",
        "envelope_a",
        "envelope_b",
        "trust_policy",
        "signed_header"
      ]
    }
  },
  "required": [
    "version",
    "key_id",
    "snapshot_id",
    "artifacts"
  ]
}
