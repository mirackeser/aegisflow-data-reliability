{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1"
    },
    "purpose": {
      "enum": [
        "usage-attestation",
        "recovery-decision"
      ]
    },
    "principal_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$",
      "minLength": 36,
      "maxLength": 36
    },
    "operation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "key_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "issued_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000000000
    },
    "expires_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000000000
    }
  },
  "required": [
    "version",
    "purpose",
    "principal_id",
    "operation_sha256",
    "key_sha256",
    "payload_sha256",
    "issued_at_ms",
    "expires_at_ms"
  ]
}
