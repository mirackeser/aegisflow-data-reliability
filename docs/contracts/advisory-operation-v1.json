{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$",
      "minLength": 36,
      "maxLength": 36
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$",
      "minLength": 36,
      "maxLength": 36
    },
    "incident_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$",
      "minLength": 36,
      "maxLength": 36
    },
    "record_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "response_schema_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "evidence_sha256": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "minLength": 64,
        "maxLength": 64
      },
      "uniqueItems": true,
      "maxItems": 4,
      "minItems": 1
    },
    "allowed_models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._/-]{0,63}$",
        "maxLength": 64,
        "not": {
          "pattern": "\\s"
        }
      }
    },
    "deadline_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000000000
    }
  },
  "required": [
    "version",
    "operation_id",
    "run_id",
    "incident_id",
    "record_sha256",
    "prompt_sha256",
    "context_sha256",
    "response_schema_sha256",
    "evidence_sha256",
    "allowed_models",
    "deadline_ms"
  ]
}
